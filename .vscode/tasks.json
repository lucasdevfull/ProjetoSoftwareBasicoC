{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configurar Release",
            "type": "shell",
            "command": "cmake -S . -B build-release -G Ninja -DCMAKE_BUILD_TYPE=Release",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "Build Release",
            "type": "shell",
            "command": "cmake --build build-release",
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": "Configurar Release",
            "problemMatcher": ["$gcc"]
        }
    ]
}