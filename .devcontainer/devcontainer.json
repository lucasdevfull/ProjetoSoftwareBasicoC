{
    "name": "Ambiente C e OpenGL/FreeGLUT",
    "build": {
        "dockerfile": "../Dockerfile"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "llvm-vs-code-extensions.vscode-clangd", // Autocomplete e navegação ultra-rápidos
                "twxs.cmake",                            // Colorização do CMakeLists.txt
                "ms-vscode.cmake-tools",                  // Botões de Build/Run
                "vadimcn.vscode-lldb"                     // Debugger integrado
            ],
            "settings": {
                "cmake.generator": "Ninja",
                "cmake.configureOnOpen": true,
                "cmake.exportCompileCommands": true,
                "C_Cpp.intelliSenseEngine": "disabled",   // Evita conflito com o clangd
                "clangd.arguments": [
                    "--compile-commands-dir=${workspaceFolder}/build",
                    "--background-index",
                    "--clang-tidy",
                    "--header-insertion=iwyu"
                ]
            }
        }
    },
    // "initializeCommand": "xhost +local:",
   "runArgs": [
        "--cap-add=SYS_PTRACE",
        "--security-opt", "seccomp=unconfined",
        "--net=host",
        "--ipc=host",
        "--device=/dev/dri",
        "-v", "/tmp/.X11-unix:/tmp/.X11-unix:rw",
        "-v", "${env:XDG_RUNTIME_DIR}/${env:WAYLAND_DISPLAY}:/tmp/wayland-0:rw"
    ],
    "containerEnv": {
        "DISPLAY": "${localEnv:DISPLAY}",
        "WAYLAND_DISPLAY": "wayland-0",
        "XDG_RUNTIME_DIR": "/tmp"
    }
}